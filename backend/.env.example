# Copy to .env for local dev (docker-compose injects its own values).
DATABASE_URL=postgresql://stroke:stroke@localhost:5432/stroke
REDIS_URL=redis://localhost:6379/0

APP_BASE_URL=http://localhost:8000
SECRET_KEY=dev-secret-change-me

# Strava API app (https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_WEBHOOK_VERIFY_TOKEN=dev-verify-token

# Object storage (S3-compatible: Railway bucket / R2 / S3) for raw streams
S3_ENDPOINT=
S3_BUCKET=stroke-streams
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
